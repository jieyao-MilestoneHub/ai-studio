{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PATH": "C:\\ffmpeg\\ffmpeg-master-latest-win64-gpl\\bin;C:\\Program Files\\Git\\usr\\bin;$PATH"
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
