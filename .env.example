# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every one of these is read through ai_studio.config.settings as a SecretStr.

# --- RunPod ----------------------------------------------------------------
# From https://console.runpod.io/user/settings, or use `flash login` / the
# runpod MCP OAuth session instead.
RUNPOD_API_KEY=

# Hugging Face read token (https://huggingface.co/settings/tokens). Required:
# omni-research/Tarsier2-7b-0115 (/說影) is a gated repo -- accept its terms
# on huggingface.co once with this account, then pod_setup.sh can fetch it.
# Fed to the pod on stdin at provision time, never written to its disk.
HF_TOKEN=
# Optional: a network volume (secure cloud, licence-safe datacenter) that keeps
# the 68GB of weights between pods. `runpodctl network-volume create --name
# ai-studio-weights --data-center-id EUR-IS-1 --size 100` -- about $7/month,
# versus ~15 minutes and $0.18 of GPU time per cold open without it.
AI_STUDIO_NETWORK_VOLUME_ID=

# --- ComfyUI ---------------------------------------------------------------
# Set after `ai-studio pod up` prints the proxy URL, e.g.
#   https://<pod-id>-8188.proxy.runpod.net
# Leave blank to drive a locally running ComfyUI at http://127.0.0.1:8188
AI_STUDIO_COMFY_URL=

# --- object storage (phase 2: serving the finished mp4 to LINE) ------------
AI_STUDIO_S3_ENDPOINT_URL=
AI_STUDIO_S3_BUCKET=
AI_STUDIO_S3_ACCESS_KEY_ID=
AI_STUDIO_S3_SECRET_ACCESS_KEY=
AI_STUDIO_S3_PUBLIC_BASE_URL=

# --- always-on service (phase 2/5.3: the FastAPI + LINE bot host) ----------
# The externally reachable HTTPS origin. Goes into every link the bot replies
# with, so it must be the public hostname, not localhost, in production.
# Leave blank to default to http://localhost:8000. Behind a tunnel (ngrok on
# the Jetson, cloudflared elsewhere) this is the tunnel's hostname -- use a
# reserved/static one, because the value is baked into reply links and media
# URLs at process start and the LINE webhook URL is set once in the console.
AI_STUDIO_PUBLIC_BASE_URL=
# Where /files serves finished media from. Leave blank to default to ./files.
AI_STUDIO_FILES_DIR=
# Where received photos are cached for image-to-video/image. Leave blank -> ./incoming.
AI_STUDIO_INCOMING_DIR=
# Delete delivered media and received photos older than this many days
# (`ai-studio gc`, run daily by the deploy scripts' timer). 0 disables it.
AI_STUDIO_FILES_RETENTION_DAYS=7

# --- prompt rewriting -------------------------------------------------------
# Every request is rewritten into its model's best input shape by gpt-oss-20b
# on the pod (deploy/inference_server.py) before it renders -- the worker
# batches the rewrites so N clips pay one model load. No serverless endpoint
# is involved any more (retired 2026-08-27).
# structured (default): rewrite.  raw: the user's words go to the model verbatim.
AI_STUDIO_PROMPT_MODE=

# --- cost guardrail --------------------------------------------------------
# Hard ceiling per run, in USD. `ai-studio estimate` refuses to submit above it.
AI_STUDIO_MAX_COST_USD=5.00
# Hard calendar-month ceiling across every window, enforced before a pod opens.
AI_STUDIO_MAX_MONTH_USD=50.00
# The always-on host's own monthly cost, reserved out of MAX_MONTH_USD before
# computing what's left for GPU compute.
AI_STUDIO_VPS_MONTHLY_USD=5.00
# How many pods may be created in one Asia/Taipei day.
AI_STUDIO_MAX_POD_OPENS_PER_DAY=15
# How many requests one LINE user may have accepted in an Asia/Taipei day. 0
# disables the cap.
AI_STUDIO_MAX_JOBS_PER_USER_PER_DAY=10

# --- LINE ------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# The one group this bot serves. Leave empty to run capture mode, which prints
# the id and accepts no work -- an unset allowlist must not mean "serve everyone".
LINE_ALLOWED_GROUP_ID=

# Optional second gate, INSIDE the group. Comma-separated LINE user ids.
#
# Empty means any member of the group can trigger a render. That is a real
# exposure and not a small one: group membership is not yours to control, so
# anyone an existing member invites can spend GPU time from the moment they
# join. Set this if the group's roster can change without your say-so.
#
# To collect the ids: leave it empty, let people use the bot, and read them off
# the log -- every accepted request logs `user=<id>`, and every refusal logs the
# id that was refused, so the log alone is enough to authorise someone.
LINE_ALLOWED_USER_IDS=
