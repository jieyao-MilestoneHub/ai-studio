# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every one of these is read through videogen.config.settings as a SecretStr.

# --- RunPod ----------------------------------------------------------------
# From https://console.runpod.io/user/settings, or use `flash login` / the
# runpod MCP OAuth session instead.
RUNPOD_API_KEY=

# --- ComfyUI ---------------------------------------------------------------
# Set after `videogen pod up` prints the proxy URL, e.g.
#   https://<pod-id>-8188.proxy.runpod.net
# Leave blank to drive a locally running ComfyUI at http://127.0.0.1:8188
VIDEOGEN_COMFY_URL=

# --- object storage (phase 2: serving the finished mp4 to LINE) ------------
VIDEOGEN_S3_ENDPOINT_URL=
VIDEOGEN_S3_BUCKET=
VIDEOGEN_S3_ACCESS_KEY_ID=
VIDEOGEN_S3_SECRET_ACCESS_KEY=
VIDEOGEN_S3_PUBLIC_BASE_URL=

# --- cost guardrail --------------------------------------------------------
# Hard ceiling per run, in USD. `videogen estimate` refuses to submit above it.
VIDEOGEN_MAX_COST_USD=5.00

# --- LINE ------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# The one group this bot serves. Leave empty to run capture mode, which prints
# the id and accepts no work -- an unset allowlist must not mean "serve everyone".
LINE_ALLOWED_GROUP_ID=

# Optional second gate, INSIDE the group. Comma-separated LINE user ids.
#
# Empty means any member of the group can trigger a render. That is a real
# exposure and not a small one: group membership is not yours to control, so
# anyone an existing member invites can spend GPU time from the moment they
# join. Set this if the group's roster can change without your say-so.
#
# To collect the ids: leave it empty, let people use the bot, and read them off
# the log -- every accepted request logs `user=<id>`, and every refusal logs the
# id that was refused, so the log alone is enough to authorise someone.
LINE_ALLOWED_USER_IDS=
