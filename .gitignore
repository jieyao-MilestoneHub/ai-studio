# --- run artifacts & media -------------------------------------------------
# Never commit generated media or run directories. A CI test asserts these
# patterns actually work (tests/unit/test_gitignore.py) — the classic way an
# OSS repo leaks material is a .gitignore that was edited and never verified.
runs/
out/
files/
incoming/
logs/
archive/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.jpg
*.jpeg
*.png

# --- model weights ---------------------------------------------------------
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
models/

# --- fonts (not redistributable) -------------------------------------------
assets/fonts/*
!assets/fonts/README.md

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.local.toml
*.pem
*.key

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- local reference material, not part of the repo -----------------------
runpot-suggestion.md

# --- flash SDK local state ------------------------------------------------
.flash/

# --- machine-local Claude Code config --------------------------------------
# Per-machine overrides (e.g. a Windows contributor's ffmpeg PATH prepend).
# Never commit this: it is not portable across OSes and previously broke
# every PreToolUse:Bash hook on Linux/macOS by clobbering PATH outright.
.claude/settings.local.json

# --- twin/ subsystem: third-party data guardrail (SPEC.md §8 guardrail 2) --
# Belt-and-suspenders: twin/.gitignore (nested) already covers these under
# twin/ regardless of cwd, and .pre-commit-config.yaml hard-blocks them even
# past `git add -f`. Kept here too since it's zero-cost — but this copy isn't
# what does the enforcing; don't remove the nested twin/.gitignore instead.
twin/data/
twin/adapters/
twin/transcripts/
twin/eval/

# --- everything that is not GPU testing: local only ------------------------
# This repository publishes one thing: what a rented GPU costs and delivers.
# The digital-twin side quest is a separate project with its own stack, its own
# spec and its own personal data; the tooling below serves only it, and
# published beside a directory that is not here it would point at files nobody
# can read. Earlier commits still contain twin/ -- history is not rewritten,
# this only stops publishing further changes to it.
twin/
.claude/agents/data-hygiene.md
.claude/agents/eval-judge.md
.claude/agents/spec-auditor.md
.claude/skills/data-contract/
.claude/skills/eval-harness/
.claude/skills/spec-trace/

# --- application layer: local only ----------------------------------------
# The request side (LINE/社群 webhook, queue, worker, delivery) and its
# Square bridge sidecar are deliberately not published: this repository is
# about what one rented GPU costs and delivers, and an application built on
# it is a different project with different concerns (chat credentials,
# member ids, a live service someone operates). Both directories stay on the
# working machine. Earlier commits still contain fun_workflow/ — history is
# not rewritten, this only stops publishing further changes to it.
fun_workflow/
square_bridge/
